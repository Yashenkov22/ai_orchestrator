  "messages": [
    { "id": 10101, "created_at": "2026-03-10T14:00:00", "text": "Привет! Хочу узнать про доставку в регионы.",                                                                                                   "sender": "user",      "status": "approved", "thread_id": 101 },
    { "id": 10102, "created_at": "2026-03-10T14:01:00", "text": "Привет! Доставляем по всей России. Сроки: Москва и СПб — 1-2 дня, регионы — 3-7 дней. Какой город вас интересует?",                             "sender": "assistant", "status": "approved", "thread_id": 101 },
    { "id": 10103, "created_at": "2026-03-10T14:03:00", "text": "Новосибирск",                                                                                                                                    "sender": "user",      "status": "approved", "thread_id": 101 },
    { "id": 10104, "created_at": "2026-03-10T14:04:00", "text": "В Новосибирск доставим за 4-5 рабочих дней. Стоимость — 350₽, при заказе от 3000₽ доставка бесплатная. Оформить заказ?",                        "sender": "assistant", "status": "approved", "thread_id": 101 },
    { "id": 10105, "created_at": "2026-03-10T14:05:00", "text": "Да, хочу оформить. Какие способы оплаты?",                                                                                                      "sender": "user",      "status": "approved", "thread_id": 101 },
    { "id": 10106, "created_at": "2026-03-10T14:06:00", "text": "Принимаем карты Visa/MasterCard/МИР, СБП и наличные при получении. Что предпочитаете?",                                                         "sender": "assistant", "status": "pending",  "thread_id": 101 },

    { "id": 10201, "created_at": "2026-03-09T09:41:00", "text": "Какие размеры есть у платья с последнего поста?",                                                                                               "sender": "user",      "status": "approved", "thread_id": 102 },
    { "id": 10202, "created_at": "2026-03-09T09:43:00", "text": "Платье доступно в размерах XS, S, M, L и XL. Если хотите, могу помочь с подбором по параметрам — напишите рост и обхват груди.",               "sender": "assistant", "status": "approved", "thread_id": 102 },
    { "id": 10203, "created_at": "2026-03-09T09:45:00", "text": "Рост 168, грудь 88",                                                                                                                            "sender": "user",      "status": "approved", "thread_id": 102 },
    { "id": 10204, "created_at": "2026-03-09T09:46:00", "text": "Отлично, вам подойдёт размер M. В наличии есть чёрный и бежевый. Какой цвет нравится?",                                                         "sender": "assistant", "status": "pending",  "thread_id": 102 },

    { "id": 10301, "created_at": "2026-03-08T18:00:00", "text": "Есть ли скидки для новых покупателей?",                                                                                                         "sender": "user",      "status": "approved", "thread_id": 103 },
    { "id": 10302, "created_at": "2026-03-08T18:01:00", "text": "Да! Для новых покупателей действует скидка 10% на первый заказ. Промокод пришлём после регистрации на сайте. Хотите ссылку?",                    "sender": "assistant", "status": "rejected", "thread_id": 103 },
    { "id": 10303, "created_at": "2026-03-08T18:03:00", "text": "Да, пришлите",                                                                                                                                  "sender": "user",      "status": "approved", "thread_id": 103 },

    { "id": 20101, "created_at": "2026-03-11T20:00:00", "text": "Посмотрел ваш профиль, интересуют наушники. Есть беспроводные до 5000₽?",                                                                       "sender": "user",      "status": "approved", "thread_id": 201 },
    { "id": 20102, "created_at": "2026-03-11T20:02:00", "text": "Да, есть несколько моделей: JBL Tune 510BT — 3 990₽, Sony WH-CH520 — 4 890₽. JBL чуть компактнее, Sony — лучше по звуку. Что важнее?",         "sender": "assistant", "status": "approved", "thread_id": 201 },
    { "id": 20103, "created_at": "2026-03-11T20:05:00", "text": "Звук важнее. Sony есть в наличии?",                                                                                                             "sender": "user",      "status": "approved", "thread_id": 201 },
    { "id": 20104, "created_at": "2026-03-11T20:06:00", "text": "Sony WH-CH520 есть в чёрном и белом. Доставка завтра при заказе до 22:00. Оформить?",                                                           "sender": "assistant", "status": "pending",  "thread_id": 201 },

    { "id": 20201, "created_at": "2026-03-10T13:35:00", "text": "Хочу купить смартфон до 30 000₽. Что посоветуете?",                                                                                             "sender": "user",      "status": "approved", "thread_id": 202 },
    { "id": 20202, "created_at": "2026-03-10T13:37:00", "text": "В этом бюджете отлично себя показывают Xiaomi 13T и Samsung Galaxy A55. Что важнее — камера или батарея?",                                       "sender": "assistant", "status": "approved", "thread_id": 202 },
    { "id": 20203, "created_at": "2026-03-10T13:40:00", "text": "Камера, снимаю много видео",                                                                                                                     "sender": "user",      "status": "approved", "thread_id": 202 },
    { "id": 20204, "created_at": "2026-03-10T13:41:00", "text": "Тогда Xiaomi 13T — лучший выбор. 50 МП основная камера, OIS, запись 4K/60fps. Цена 28 990₽. Добавить в корзину?",                               "sender": "assistant", "status": "pending",  "thread_id": 202 },

    { "id": 20301, "created_at": "2026-03-09T16:15:00", "text": "У вас есть зарядки для MacBook Pro?",                                                                                                           "sender": "user",      "status": "approved", "thread_id": 203 },
    { "id": 20302, "created_at": "2026-03-09T16:17:00", "text": "Есть оригинальные Apple USB-C 67W и 96W, а также совместимые Baseus и Anker. Какой мощности нужна?",                                            "sender": "assistant", "status": "approved", "thread_id": 203 },
    { "id": 20303, "created_at": "2026-03-09T16:20:00", "text": "96W, оригинальная",                                                                                                                             "sender": "user",      "status": "approved", "thread_id": 203 },

    { "id": 30101, "created_at": "2026-02-28T09:55:00", "text": "Добрый день! Есть ли у вас корейская косметика?",                                                                                               "sender": "user",      "status": "approved", "thread_id": 301 },
    { "id": 30102, "created_at": "2026-02-28T09:57:00", "text": "Добрый день! Да, работаем с брендами COSRX, Some By Mi, Innisfree. Что ищете — уход за лицом, маски или что-то другое?",                        "sender": "assistant", "status": "approved", "thread_id": 301 },
    { "id": 30103, "created_at": "2026-02-28T10:00:00", "text": "Ищу сыворотку с ниацинамидом",                                                                                                                  "sender": "user",      "status": "approved", "thread_id": 301 },

    { "id": 40101, "created_at": "2026-03-11T19:20:00", "text": "Привет! Хочу купить гантели для дома, какие посоветуете?",                                                                                       "sender": "user",      "status": "approved", "thread_id": 401 },
    { "id": 40102, "created_at": "2026-03-11T19:22:00", "text": "Привет! Для дома отлично подходят разборные гантели — экономят место. Есть наборы от 2 до 24 кг. Какой уровень подготовки?",                     "sender": "assistant", "status": "approved", "thread_id": 401 },
    { "id": 40103, "created_at": "2026-03-11T19:23:00", "text": "Средний, занимаюсь около года",                                                                                                                 "sender": "user",      "status": "approved", "thread_id": 401 },
    { "id": 40104, "created_at": "2026-03-11T19:25:00", "text": "Рекомендую набор Kettler 2-24 кг за 8 900₽ — хватит на долго, места занимает мало. Есть в наличии. Оформить?",                                   "sender": "assistant", "status": "pending",  "thread_id": 401 },
    { "id": 40105, "created_at": "2026-03-11T19:27:00", "text": "А есть что-то подешевле?",                                                                                                                      "sender": "user",      "status": "approved", "thread_id": 401 },
    { "id": 40106, "created_at": "2026-03-11T19:30:00", "text": "Есть вариант попроще — набор Torneo 2-20 кг за 5 490₽. Чуть меньше максимальный вес, но для среднего уровня хватит.",                           "sender": "assistant", "status": "pending",  "thread_id": 401 },

    { "id": 40201, "created_at": "2026-03-10T13:50:00", "text": "Сколько стоит протеин ON Gold Standard?",                                                                                                       "sender": "user",      "status": "approved", "thread_id": 402 },
    { "id": 40202, "created_at": "2026-03-10T13:52:00", "text": "ON Gold Standard Whey 907г — 4 200₽, 2,27 кг — 8 900₽. Второй вариант выгоднее на порцию. Что предпочтёте?",                                    "sender": "assistant", "status": "approved", "thread_id": 402 },
    { "id": 40203, "created_at": "2026-03-10T13:55:00", "text": "2 кг. Какой вкус вкуснее по отзывам?",                                                                                                          "sender": "user",      "status": "approved", "thread_id": 402 },
    { "id": 40204, "created_at": "2026-03-10T14:00:00", "text": "По отзывам лидируют Double Rich Chocolate и Vanilla Ice Cream. Шоколад — более насыщенный, ваниль — нейтральный. Добавить в корзину?",           "sender": "assistant", "status": "pending",  "thread_id": 402 },

    { "id": 40301, "created_at": "2026-03-08T10:45:00", "text": "Есть коврики для йоги?",                                                                                                                        "sender": "user",      "status": "approved", "thread_id": 403 },
    { "id": 40302, "created_at": "2026-03-08T10:47:00", "text": "Да, есть три варианта: базовый TPE 6мм — 1 290₽, профессиональный каучук 4мм — 3 900₽, и премиум пробка+каучук — 6 500₽. Для какого уровня?", "sender": "assistant", "status": "approved", "thread_id": 403 },
    { "id": 40303, "created_at": "2026-03-08T11:00:00", "text": "Для начинающего, не хочу переплачивать",                                                                                                        "sender": "user",      "status": "approved", "thread_id": 403 },

    { "id": 50101, "created_at": "2026-01-30T07:55:00", "text": "test message 1",                                                                                                                                 "sender": "user",      "status": "approved", "thread_id": 501 },
    { "id": 50102, "created_at": "2026-01-30T07:57:00", "text": "test response from assistant",                                                                                                                   "sender": "assistant", "status": "pending",  "thread_id": 501 },
    { "id": 50103, "created_at": "2026-01-30T08:00:00", "text": "ok got it",                                                                                                                                     "sender": "user",      "status": "approved", "thread_id": 501 },

    { "id": 90101, "created_at": "2026-03-05T11:50:00", "text": "Привет, вы продаёте одежду?",                                                                                                                   "sender": "user",      "status": "approved", "thread_id": 901 },
    { "id": 90102, "created_at": "2026-03-05T11:52:00", "text": "Привет! Да, у нас большой ассортимент одежды. Расскажите, что именно ищете?",                                                                   "sender": "assistant", "status": "pending",  "thread_id": 901 },
    { "id": 90103, "created_at": "2026-03-05T12:00:00", "text": "Ищу джинсы 32 размер",                                                                                                                         "sender": "user",      "status": "approved", "thread_id": 901 },

    { "id": 90201, "created_at": "2026-03-04T09:25:00", "text": "Добрый день",                                                                                                                                   "sender": "user",      "status": "approved", "thread_id": 902 },
    { "id": 90202, "created_at": "2026-03-04T09:27:00", "text": "Добрый день! Чем могу помочь?",                                                                                                                 "sender": "assistant", "status": "pending",  "thread_id": 902 },
    { "id": 90203, "created_at": "2026-03-04T09:30:00", "text": "Хочу узнать про условия доставки",                                                                                                             "sender": "user",      "status": "approved", "thread_id": 902 }
  ]
